{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wujun-os.local/spec/schemas/pillar_schema.json",
  "title": "Wujun OS Pillars Dictionary",
  "type": "object",
  "required": [
    "version",
    "pillars"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "string",
      "const": "v1.0"
    },
    "source": {
      "type": "string"
    },
    "pillars": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {
        "$ref": "#/$defs/l1_pillar"
      }
    }
  },
  "$defs": {
    "l2_pillar": {
      "type": "object",
      "required": [
        "code",
        "name",
        "definition",
        "include",
        "exclude_routing",
        "caliber",
        "capability_tags"
      ],
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^D\\d{2}-\\d+$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "definition": {
          "type": "string"
        },
        "include": {
          "type": "string"
        },
        "exclude_routing": {
          "type": "string"
        },
        "caliber": {
          "type": "string"
        },
        "capability_tags": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "思",
              "学",
              "沟",
              "做"
            ]
          },
          "uniqueItems": true
        }
      }
    },
    "l1_pillar": {
      "type": "object",
      "required": [
        "code",
        "name",
        "category",
        "focus",
        "one_line_definition",
        "core_question",
        "criteria_conclusion_test",
        "neighbor_rules",
        "l2_children"
      ],
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^D\\d{2}$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "type": "string",
          "enum": [
            "对内",
            "对外"
          ]
        },
        "focus": {
          "type": "boolean"
        },
        "one_line_definition": {
          "type": "string"
        },
        "core_question": {
          "type": "string"
        },
        "criteria_conclusion_test": {
          "type": "string"
        },
        "neighbor_rules": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "l2_children": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/l2_pillar"
          }
        }
      }
    }
  }
}
